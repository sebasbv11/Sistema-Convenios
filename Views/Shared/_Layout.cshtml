<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Convenios FCVT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (() => {
            const savedTheme = localStorage.getItem("fcvt-theme");
            document.documentElement.dataset.bsTheme = savedTheme ??
                (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        })();
    </script>
</head>
<body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-expand navbar-dark app-navbar">
            <div class="container-fluid">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none">
                    <img src="~/images/logo-uleam.png" alt="ULEAM" class="brand-logo" />
                    <span>FCVT-Convenios</span>
                </a>
                <div class="ms-auto d-flex align-items-center gap-2 gap-md-3">
                    <span class="text-white-50 small d-none d-lg-inline">@User.Identity.Name</span>
                    <button id="theme-toggle" type="button" class="btn btn-sm btn-outline-light" aria-label="Cambiar a modo oscuro" title="Cambiar tema">
                        <span aria-hidden="true">◐</span> <span id="theme-label">Modo oscuro</span>
                    </button>
                    <a asp-controller="Home" asp-action="Ayuda" class="text-white-50 small text-decoration-none">Ayuda</a>
                    <a asp-controller="Account" asp-action="CambiarPassword" class="text-white-50 small text-decoration-none d-none d-lg-inline">🔒 Cambiar contraseña</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-light">Salir</button>
                    </form>
                </div>
            </div>
        </nav>

        <div class="container-fluid">
            <div class="row">
                <div class="col-md-2 sidebar py-2">
                    <nav class="nav flex-column" aria-label="Navegación principal">
                        <span class="nav-section">Principal</span>
                        <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                            🏠 Dashboard
                        </a>
                        <a asp-controller="Convenios" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Convenios" ? "active" : "")">
                            📄 Convenios
                        </a>
                        <a asp-controller="Entidades" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Entidades" ? "active" : "")">
                            🏢 Entidades
                        </a>
                        <a asp-controller="Reportes" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? "active" : "")">
                            📊 Reportes
                        </a>
                        <span class="nav-section">Sistema</span>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Usuarios" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")">👥 Usuarios y roles</a>
                        }
                        <a asp-controller="Account" asp-action="CambiarPassword" class="nav-link">🔒 Mi contraseña</a>
                    </nav>
                </div>
                <div class="col-md-10">
                    <main id="contenido-principal" tabindex="-1">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <div id="theme-announcement" class="visually-hidden" aria-live="polite"></div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
