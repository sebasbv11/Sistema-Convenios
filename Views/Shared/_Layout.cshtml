<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Convenios FCVT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .navbar-brand { font-weight: 700; letter-spacing: 1px; }
        .sidebar { min-height: calc(100vh - 56px); background: #f8f9fa; border-right: 1px solid #dee2e6; }
        .sidebar .nav-link { color: #495057; font-size: 0.875rem; padding: 0.5rem 1rem; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background: #e9ecef; color: #1a3a6b; border-radius: 6px; }
        .sidebar .nav-section { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: #adb5bd; padding: 1rem 1rem 0.25rem; }
        main { padding: 1.5rem; }
    </style>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-expand navbar-dark" style="background:#1a3a6b;">
            <div class="container-fluid">
                <span class="navbar-brand">FCVT · Convenios · STAGING</span>
                <div class="ms-auto d-flex align-items-center gap-3">
                    <span class="text-white-50 small">@User.Identity.Name</span>
                    <a asp-controller="Account" asp-action="CambiarPassword" class="text-white-50 small text-decoration-none">🔒 Cambiar contraseña</a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-light">Salir</button>
                    </form>
                </div>
            </div>
        </nav>

        <div class="container-fluid">
            <div class="row">
                <div class="col-md-2 sidebar py-2">
                    <nav class="nav flex-column">
                        <span class="nav-section">Principal</span>
                        <a asp-controller="Home" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                            🏠 Dashboard
                        </a>
                        <a asp-controller="Convenios" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Convenios" ? "active" : "")">
                            📄 Convenios
                        </a>
                        <a asp-controller="Entidades" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Entidades" ? "active" : "")">
                            🏢 Entidades
                        </a>
                        <a asp-controller="Reportes" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reportes" ? "active" : "")">
                            📊 Reportes
                        </a>
                        <span class="nav-section">Sistema</span>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Usuarios" asp-action="Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")">👥 Usuarios y roles</a>
                        }
                        <a asp-controller="Account" asp-action="CambiarPassword" class="nav-link">🔒 Mi contraseña</a>
                    </nav>
                </div>
                <div class="col-md-10">
                    <main>
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
