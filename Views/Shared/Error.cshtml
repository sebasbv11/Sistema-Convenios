@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <h1 class="text-danger">No pudimos completar la solicitud.</h1>
    <p class="text-muted">Inténtalo nuevamente. Si el problema continúa, contacta al administrador del sistema.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
</div>

@if (Model.ShowRequestId)
{
    <p class="text-center text-muted small">
        Código de solicitud: <code>@Model.RequestId</code>
    </p>
}
