@{
    Layout = null;
    ViewData["Title"] = "Correo enviado";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Correo enviado — FCVT</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: #f0f2f5; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { background: #fff; border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); padding: 2.5rem 2rem; width: 100%; max-width: 480px; }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <div class="fs-1 mb-2">✉️</div>
        <h5 class="mb-3">Revisa tu correo</h5>
        <p class="text-muted small">
            Si el correo está registrado en el sistema, recibirás un enlace para restablecer tu contraseña.
            Revisa también la carpeta de spam.
        </p>

        <a asp-action="Login" class="btn btn-primary mt-3">Volver al inicio de sesión</a>
    </div>
</body>
</html>
