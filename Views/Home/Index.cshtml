@model IEnumerable<SistemaConvenios.Application.Convenios.ConvenioListaDto>
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm text-center h-100">
            <div class="card-body">
                <div style="font-size:2rem;font-weight:700;color:#1a3a6b">@ViewBag.TotalActivos</div>
                <div class="text-muted small">Convenios vigentes</div>
                <div class="text-muted" style="font-size:0.7rem">En vigor hoy</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm text-center h-100">
            <div class="card-body">
                <div style="font-size:2rem;font-weight:700;color:#cc6600">@ViewBag.PorVencer30</div>
                <div class="text-muted small">Vencen en 30 días</div>
                <div class="text-muted" style="font-size:0.7rem">Activos con vencimiento próximo</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm text-center h-100">
            <div class="card-body">
                <div style="font-size:2rem;font-weight:700;color:#555">@ViewBag.RenovadosAutomaticos</div>
                <div class="text-muted small">Renovados automáticos</div>
                <div class="text-muted" style="font-size:0.7rem">Estado renovado automático</div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm text-center h-100">
            <div class="card-body">
                <div style="font-size:2rem;font-weight:700;color:#1a6b2e">@ViewBag.Internacionales</div>
                <div class="text-muted small">Internacionales vigentes</div>
                <div class="text-muted" style="font-size:0.7rem">Tipo internacional en vigor</div>
            </div>
        </div>
    </div>
</div>

@if ((ViewBag.PorVencer30 ?? 0) > 0)
{
    <div class="alert alert-warning">
        ⚠ <strong>@ViewBag.PorVencer30 convenio(s)</strong> vencen en menos de 30 días.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Convenios por tipo</div>
            <div class="card-body">
                <canvas id="chartTipos" height="180"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Convenios por estado</div>
            <div class="card-body">
                <canvas id="chartEstados" height="180"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Carreras con más convenios</div>
            <div class="card-body">
                <canvas id="chartCarreras" height="180"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="mb-0">Convenios recientes</h5>
    <div class="d-flex gap-2">
        <a asp-controller="Convenios" asp-action="Index" class="btn btn-sm btn-outline-primary">
            Ver todos
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover table-sm">
        <thead class="table-light">
            <tr>
                <th>N°</th>
                <th>Entidad</th>
                <th>Tipo</th>
                <th>Vencimiento</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><code>@c.Numero</code></td>
                    <td>@c.Entidad</td>
                    <td>@c.TipoConvenio</td>
                    <td class="@(c.FechaVencimiento < DateTime.Today ? "text-danger fw-bold" : "")">
                        @c.FechaVencimiento.ToString("dd/MM/yyyy")
                    </td>
                    <td>
                        @{
                            var bc = c.Estado switch
                            {
                                "Vigente" => "success",
                                "Por vencer" => "warning",
                                "Terminado" => "secondary",
                                "Renovado automático" => "primary",
                                _ => "light text-dark border"
                            };
                        }
                        <span class="badge bg-@bc">@c.Estado</span>
                    </td>
                    <td>
                        <a asp-controller="Convenios"
                           asp-action="Detalle"
                           asp-route-id="@c.Id"
                           class="btn btn-outline-primary btn-sm">
                            Ver
                        </a>
                    </td>
                </tr>
            }

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3">
                        No hay convenios registrados aún.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const tiposLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.ConveniosPorTipoLabels ?? new List<string>()));
    const tiposData = @Html.Raw(JsonSerializer.Serialize(ViewBag.ConveniosPorTipoData ?? new List<int>()));

    const carrerasLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.ConveniosPorCarreraLabels ?? new List<string>()));
    const carrerasData = @Html.Raw(JsonSerializer.Serialize(ViewBag.ConveniosPorCarreraData ?? new List<int>()));

    const estadosLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.ConveniosPorEstadoLabels ?? new List<string>()));
    const estadosData = @Html.Raw(JsonSerializer.Serialize(ViewBag.ConveniosPorEstadoData ?? new List<int>()));

    new Chart(document.getElementById('chartTipos'), {
        type: 'bar',
        data: {
            labels: tiposLabels,
            datasets: [{
                label: 'Convenios',
                data: tiposData
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { precision: 0 }
                }
            }
        }
    });

    new Chart(document.getElementById('chartEstados'), {
        type: 'doughnut',
        data: {
            labels: estadosLabels,
            datasets: [{
                label: 'Convenios',
                data: estadosData
            }]
        },
        options: {
            responsive: true
        }
    });

    new Chart(document.getElementById('chartCarreras'), {
        type: 'bar',
        data: {
            labels: carrerasLabels,
            datasets: [{
                label: 'Convenios',
                data: carrerasData
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            plugins: {
                legend: { display: false }
            },
            scales: {
                x: {
                    beginAtZero: true,
                    ticks: { precision: 0 }
                }
            }
        }
    });
</script>
