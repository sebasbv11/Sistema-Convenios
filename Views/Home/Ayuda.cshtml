@{
    ViewData["Title"] = "Ayuda";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Ayuda rápida</h1>
        <p class="text-muted mb-0">Guía breve para realizar las tareas más comunes.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver al dashboard</a>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <section class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Consultar y filtrar</h2>
            <p class="mb-0">Usa Convenios, Entidades o Reportes. Aplica los filtros y usa “Limpiar” para volver a ver todos los registros.</p>
        </div></section>
    </div>
    <div class="col-md-6">
        <section class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Reportes y exportación</h2>
            <p class="mb-0">Las exportaciones PDF y Excel están en Reportes y respetan los filtros aplicados.</p>
        </div></section>
    </div>
    <div class="col-md-6">
        <section class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Permisos</h2>
            <p class="mb-0">Visualizador consulta. Secretaría gestiona convenios, entidades y documentos. Administración también gestiona usuarios.</p>
        </div></section>
    </div>
    <div class="col-md-6">
        <section class="card h-100 shadow-sm"><div class="card-body">
            <h2 class="h5">Tema y accesibilidad</h2>
            <p class="mb-0">Usa el botón “Modo oscuro” de la barra superior. Tu preferencia se conserva para la próxima visita.</p>
        </div></section>
    </div>
</div>
